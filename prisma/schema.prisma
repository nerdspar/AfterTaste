// AfterTaste — self-hosted Postgres schema.
// Model: each user belongs to one household; recipes, groceries, meal plan,
// ratings, and favorites are household-shared; recently-viewed is per-user.
// Access is scoped to the session's household in the app layer.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the debian target matches the node:slim Docker image.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  displayName  String?
  avatarUrl    String?
  accent       String  @default("orange")
  theme        String  @default("system")
  units        String  @default("imperial")

  // Per-user app preferences (sync across the user's devices).
  nutritionEnabled     Boolean  @default(false)
  keepAwake            Boolean  @default(false)
  notificationsEnabled Boolean  @default(true)
  clipboardDetect      Boolean  @default(true)
  tabConfig            String[] @default([]) // empty = the default bottom tabs
  // "field:direction" for the My Recipes sort; remembers the last one picked.
  recipeSort           String   @default("title:asc")
  // Ordered list of visible dashboard section ids; empty = the default set.
  dashboardSections    String[] @default([])
  // Add-recipe button placement: "header" | "fab" | "off".
  addButton            String   @default("header")
  /// Start-cooking button placement on a recipe: "header" | "fab" | "off",
  /// mirroring addButton. "off" is safe because the recipe's "..." menu always
  /// carries the action.
  cookButton           String   @default("fab")

  // Push notifications. The subscription rows say which devices can be
  // reached; these say what the user actually wants sent to them.
  pushNewRecipes    Boolean @default(true)
  pushCookNudge     Boolean @default(true)
  /// How long a recipe must stay open, in minutes, before we take it as
  /// "they're cooking this" and queue the did-you-make-it nudge.
  cookNudgeAfterMin Int     @default(3)
  /// How long after that to actually ask, in hours. An hour tends to land
  /// mid-meal; three gets them after they've eaten.
  cookNudgeDelayHr  Int     @default(3)
  /// Alerts for the run of show on the day of a party.
  pushPartySteps    Boolean @default(true)
  /// How many minutes of warning before a step is due. Zero means "when it is
  /// due"; the default gives you time to get to the kitchen.
  partyAlertLeadMin Int     @default(10)
  /// Quiet hours, local to the user. A nudge falling inside them waits for
  /// the morning rather than buzzing at midnight.
  quietFromHour     Int     @default(21)
  quietToHour       Int     @default(8)
  /// IANA zone captured from the browser, so quiet hours mean the user's
  /// evening and not the server's.
  timeZone          String?

  // Personal daily nutrition goals (per user, not household). Null = unset.
  calorieGoal  Int?
  proteinGoalG Int?
  carbsGoalG   Int?
  fatGoalG     Int?

  household   Household? @relation("HouseholdMembers", fields: [householdId], references: [id])
  householdId String?

  ownedHouseholds Household[]             @relation("HouseholdOwner")
  createdRecipes  Recipe[]                @relation("RecipeCreator")
  recentlyViewed  RecentlyViewed[]
  sentInvites     HouseholdInvite[]       @relation("InviteSender")
  passwordResets  PasswordResetToken[]
  foodLog         FoodLogEntry[]
  pushSubs        PushSubscription[]
  scheduledNotes  ScheduledNotification[]

  createdAt DateTime @default(now())
}

// A personal food-log entry: what a single user ate on a given day. Decoupled
// from the shared meal plan. Macros are snapshotted at log time so later edits
// to the source recipe don't rewrite history.
model FoodLogEntry {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  date String // local YYYY-MM-DD
  meal String // Breakfast | Lunch | Dinner | Snack

  // Optional link back to a recipe; kept even if the recipe is later deleted.
  recipe   Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  recipeId String?

  name     String // display name (recipe title or a quick-add food)
  servings Float  @default(1) // portions eaten

  // Per-serving macro snapshot.
  calories Int  @default(0)
  proteinG Int?
  carbsG   Int?
  fatG     Int?
  fiberG   Int?
  sugarG   Int?
  sodiumMg Int?

  createdAt DateTime @default(now())

  @@index([userId, date])
}

// Single-use, time-limited token backing the "forgot password" flow. Only the
// SHA-256 hash of the token is stored; the raw token lives only in the email.
model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Household {
  id      String @id @default(cuid())
  name    String @default("My Household")
  owner   User   @relation("HouseholdOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  members      User[]            @relation("HouseholdMembers")
  recipes      Recipe[]
  groceryItems GroceryItem[]
  mealPlan     MealPlan[]
  invites      HouseholdInvite[]
  foodMatches  IngredientMatch[]
  parties      Party[]

  createdAt DateTime @default(now())
}

model HouseholdInvite {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  email       String
  invitedBy   User?     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedById String?
  status      String    @default("pending") // pending | accepted | revoked
  createdAt   DateTime  @default(now())
}

model Recipe {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  createdBy   User?     @relation("RecipeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  title            String
  category         String  @default("Dinner")
  image            String?
  sourceUrl        String?
  rating           Float   @default(0) // community/source rating
  ratingCount      Int     @default(0)
  cookTime         String  @default("")
  cookTimeMinutes  Int     @default(0)
  prepTimeMinutes  Int     @default(0)
  totalTimeMinutes Int     @default(0)
  servings         Int     @default(4)
  calories         Int     @default(0) // per serving (kcal)
  // Extended nutrition, all per serving. Null = unknown (distinct from 0).
  proteinG         Int?
  carbsG           Int?
  fatG             Int?
  fiberG           Int?
  sugarG           Int?
  sodiumMg         Int?
  // How the nutrition was filled in: manual | imported | estimated. Lets the
  // UI badge estimates and avoids clobbering hand-entered values later.
  nutritionSource  String?
  difficulty       String  @default("Medium")
  cost             Int     @default(0)
  cookingClassType String  @default("Cozy Comfort Food")
  cuisine          String  @default("")
  source           String  @default("Original")
  description      String  @default("")
  recipeNotes      String  @default("") // notes/tips that came with the original recipe
  myNotes          String  @default("") // the household's own notes and tweaks
  ingredients      Json    @default("[]")
  instructions     Json    @default("[]")
  chef             Json?

  // shared personal ratings (household-wide)
  ease       Int      @default(0)
  taste      Int      @default(0)
  cleanup    Int      @default(0)
  makeAgain  Boolean?
  remade     Int      @default(0)
  tags       String[] @default([])
  isFavorite Boolean  @default(false) // shared favorite

  groceryItems   GroceryItem[]
  mealPlan       MealPlan[]
  recentlyViewed RecentlyViewed[]
  foodLogEntries FoodLogEntry[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  partyDishes PartyDish[]

  @@index([householdId])
}

model GroceryItem {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  name        String
  quantity    String    @default("")
  category    String    @default("Pantry Essentials")
  checked     Boolean   @default(false)
  recipe      Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  recipeId    String?
  recipeTitle String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([householdId])
}

model MealPlan {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  date        String // local YYYY-MM-DD, matching the app's slot keys
  meal        String // Breakfast | Lunch | Dinner | Snack
  recipe      Recipe?   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId    String?
  note        String?
  // A slot (household+date+meal) can hold several entries now; position orders
  // them (main first, then sides). No longer unique per slot.
  position    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([householdId])
  @@index([householdId, date, meal])
}

model RecentlyViewed {
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String
  viewedAt DateTime @default(now())

  @@id([userId, recipeId])
}

// A household's answer to "what food is this ingredient?", saved the first time
// someone corrects an estimate. The estimator consults these before it guesses,
// so a correction made once holds for everyone in the household and for every
// recipe after it — which is the only thing that makes rough public food data
// converge on being right for one kitchen.
//
// The macros are snapshotted rather than re-fetched: a saved answer should not
// change under the cook because an upstream database was edited, and a
// remembered term costs no API call.
model IngredientMatch {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  /// Normalized search term, e.g. "chicken breast" — NOT the raw ingredient
  /// line, so "3 cloves garlic, minced" and "2 cloves garlic" share an answer.
  term   String
  /// Food-database id, e.g. "usda:1105314" or "off:737628064502".
  foodId String

  // Snapshot of the chosen record (per 100 g), mirroring FoodItem.
  foodName     String
  brand        String?
  source       String // "usda" | "off"
  calories     Int
  proteinG     Int?
  carbsG       Int?
  fatG         Int?
  fiberG       Int?
  sugarG       Int?
  sodiumMg     Int?
  servingSizeG Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([householdId, term])
  @@index([householdId])
}

// A browser that has agreed to receive push. One row per device, because one
// person reasonably has a phone and a laptop, and each gets its own endpoint.
//
// Rows are disposable: push services expire endpoints, and the only way to
// learn that is a 404/410 when we try to send, at which point we delete.
model PushSubscription {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// The push service URL. Unique because it IS the device's identity — a
  /// re-subscribe on the same browser returns the same endpoint.
  endpoint String  @unique
  p256dh   String
  auth     String
  /// Only to help the owner recognise a device in Settings.
  label    String?

  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  @@index([userId])
}

// A notification to send later. The "did you make it?" nudge is queued when a
// recipe has been open long enough to mean someone is cooking, then sent hours
// afterwards — so it has to outlive the request that created it.
//
// Queued, not fired-and-forgotten: by the time it comes due the answer may
// already be in (they rated it), and then it should quietly not happen.
model ScheduledNotification {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  kind     String // "cook-nudge"
  recipeId String

  dueAt         DateTime
  sentAt        DateTime?
  /// Set instead of sentAt when the nudge came due but was no longer wanted
  /// (already rated, recipe deleted, user turned it off). Kept rather than
  /// deleted so the same recipe does not re-queue the moment it is reopened.
  skippedAt     DateTime?
  skippedReason String?

  createdAt DateTime @default(now())

  /// One pending nudge per recipe per person — reopening the recipe while one
  /// is already queued should push the time back, not stack up a second buzz.
  @@unique([userId, kind, recipeId])
  @@index([dueAt, sentAt])
}

// ---------------------------------------------------------------------------
// Party Mode
// ---------------------------------------------------------------------------
//
// A party is the granular layer inside a meal-plan day: it keys off the same
// local YYYY-MM-DD string, so the planner can find one for a date without the
// two models being coupled.
//
// Shaped from a real Friendsgiving note, which is why some of this looks less
// tidy than a model drawn from first principles:
//   - Half the schedule belongs to no dish at all (set up sternos, make
//     coffee), so PartyTask stands alone and only optionally names a dish.
//   - A dish can be an idea with no recipe, a maybe, or assigned to someone
//     who has not confirmed — "Veggie 1", "?Roasted Squash", "Mike/Megan?".
//   - "Turkey (2x)" is two birds through one oven four hours apart, not double
//     quantity, so instances are separate from the recipe multiplier.
model Party {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  title     String
  /// "The year we…" — the line the note always has under the title.
  subtitle  String?
  /// Local YYYY-MM-DD, matching MealPlan.date and the app's slot keys.
  date      String
  /// "17:30". Everything in the run of show is laid back from here.
  serveTime String  @default("18:00")
  notes     String  @default("")

  /// Set when this party was cloned from another, so next year can look back.
  clonedFrom   Party?  @relation("PartyLineage", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clonedFromId String?
  clones       Party[] @relation("PartyLineage")

  guests     Party_Guest[]
  dishes     PartyDish[]
  tasks      PartyTask[]
  items      PartyListItem[]
  partyNotes PartyNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([householdId, date])
}

/// Someone at the party. Named rather than counted, because most guests bring
/// a dish and that has to show up on the oven timeline.
model Party_Guest {
  id      String @id @default(cuid())
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)
  partyId String

  name      String
  /// Free text: "no nuts", "veggie".
  dietary   String?
  confirmed Boolean @default(false)

  dishes PartyDish[]
  tasks  PartyTask[]

  @@index([partyId])
}

model PartyDish {
  id      String @id @default(cuid())
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)
  partyId String

  /// Apps | Mains | Dessert | Drinks | Sides — free text so a party can invent one.
  course   String @default("Mains")
  /// Position within the course.
  position Int    @default(0)

  recipe   Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  recipeId String?
  /// Used when there is no recipe: "Charcuterie", "Veggie 1".
  name     String

  /// "1.5x recipe" — multiples, not servings. This is how the note thinks and
  /// what carries forward year to year.
  multiplier Float   @default(1)
  /// Two turkeys are two runs through the oven, each with its own tasks.
  instances  Int     @default(1)
  /// "both pans", "needs the big roasting tin".
  equipment  String?

  /// idea | maybe | confirmed. "Veggie 1" is an idea; "?Roasted Squash" a maybe.
  status String @default("confirmed")

  /// Null when we are making it. Set when a guest brings it — then it costs
  /// nothing on the shopping list but still takes oven time on arrival.
  broughtBy   Party_Guest? @relation(fields: [broughtById], references: [id], onDelete: SetNull)
  broughtById String?

  tasks PartyTask[]
  items PartyListItem[]

  @@index([partyId])
}

/// One line of the run of show. Free-standing: "set up sternos" and "make
/// coffee" belong to no dish, and they are half the day.
model PartyTask {
  id      String @id @default(cuid())
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)
  partyId String

  label       String
  /// 0 = the day of, -1 = the day before. The note's Friday page.
  dayOffset   Int     @default(0)
  /// "16:30" local. Null means unscheduled — sitting in the list with no time yet.
  at          String?
  durationMin Int     @default(0)

  /// Resting, proving, thawing. Occupies the clock but no oven and no hands,
  /// so it never counts as a clash or as somebody's work.
  passive Boolean @default(false)

  /// oven | burner | mixer | none. What a clash is computed against.
  resource  String @default("none")
  /// Only meaningful for the oven, and the reason two dishes can conflict
  /// while both "fit".
  ovenTempF Int?

  dish     PartyDish? @relation(fields: [dishId], references: [id], onDelete: Cascade)
  dishId   String?
  /// Which of the two turkeys this is.
  instance Int        @default(1)

  /// Who is doing it. The party's own name list, not a household account:
  /// half the jobs on the day belong to whoever is standing there, and the
  /// note writes "Pat — gravy" without anybody having an account.
  assignee   Party_Guest? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId String?

  done     Boolean @default(false)
  position Int     @default(0)

  /// When an alert for this step went out. Cleared whenever its time moves, so
  /// a step that gets rescheduled is armed again rather than silently spent.
  alertedAt DateTime?

  /// The list line this step came from, if it came from one.
  listItem PartyListItem?

  @@index([partyId])
  @@index([partyId, dayOffset])
}

/// Shopping, the house to-do, and party prep are the same shape — a nested
/// list of things to tick — so they share a table rather than building nesting
/// three times.
model PartyListItem {
  id      String @id @default(cuid())
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)
  partyId String

  /// shopping | todo | prep
  list     String
  label    String
  /// Nesting: "Clean house" › "Kitchen" › "Cabinets".
  parent   PartyListItem?  @relation("ListNesting", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  children PartyListItem[] @relation("ListNesting")

  /// Free text, because the note writes "x2" and "1 stick is plenty".
  quantity String?
  /// Fruits & Vegetables … plus Supplies, which the food categories lack.
  category String?
  /// "Trader Joe's".
  store    String?

  /// Set when the line came from a dish's ingredients. Kept so an aggregated
  /// line can show which dishes fed it — the quantity will sometimes be wrong
  /// and the breakdown is how you tell.
  dish   PartyDish? @relation(fields: [dishId], references: [id], onDelete: SetNull)
  dishId String?
  /// True once a person has touched it, so a re-derive leaves it alone.
  edited Boolean    @default(false)

  /// Set when this line is also a step in the run of show. "Make the gravy
  /// base" is one job whether you met it on the prep list or at 7pm on the
  /// Friday page, so the two rows stay one thing: tick either and both tick.
  task   PartyTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId String?    @unique

  done     Boolean @default(false)
  position Int     @default(0)

  @@index([partyId, list])
}

/// What you learned last year. The top block of the note, and the thing that
/// makes cloning worth more than copying.
model PartyNote {
  id      String @id @default(cuid())
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)
  partyId String

  text   String
  /// party | dish | ingredient
  scope  String  @default("party")
  /// A dish id, or an ingredient name — loose on purpose, since next year's
  /// dish is a different row.
  target String?

  /// Ticked off once this year's plan reflects it.
  applied  Boolean @default(false)
  position Int     @default(0)

  @@index([partyId])
}
