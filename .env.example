# =============================================================================
# AfterTaste environment
# =============================================================================

# ---- Production (Docker Compose on TrueNAS) ----
# Put THESE two in a `.env` next to docker-compose.yml. Compose builds
# DATABASE_URL from POSTGRES_PASSWORD automatically.
POSTGRES_PASSWORD=change-me-to-a-strong-password
AUTH_SECRET=generate-with-openssl-rand-base64-32

# ---- Local development (running `npm run dev` against a local Postgres) ----
# Instead of the two above, the app reads these directly:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aftertaste?schema=public"
# AUTH_SECRET="any-long-random-string-for-dev"

# ---- Optional ----
# Where uploaded recipe/step images are written. Defaults to ./uploads locally;
# docker-compose sets this to the mounted /app/uploads volume.
# UPLOADS_DIR=/app/uploads

# Food-database search (food log). Open Food Facts needs no key. USDA
# FoodData Central works without one via the shared DEMO_KEY, but that is
# rate-limited — get a free key at https://fdc.nal.usda.gov/api-key-signup.html
# FDC_API_KEY=your-usda-fdc-key
